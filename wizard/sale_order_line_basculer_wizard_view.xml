<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sale_order_line_basculer_wizard_form_view" model="ir.ui.view">
            <field name="name">sale.order.line.basculer.wizard.form</field>
            <field name="model">sale.order.line.basculer.wizard</field>
            <field name="arch" type="xml">
                <form string="Basculer sur un autre article">
                    <div style="background:Gainsboro;padding:8px;margin-bottom:12px">
                        <div>Les lignes sélectionnées sont déplacées sur la commande ouverte du nouvel article pour le même client.</div>
                        <div>Cette commande ouverte doit d'abord être créée par l'ADV.</div>
                        <div>Les quantités et les dates sont gardées, le prix est recalculé avec la liste de prix de la nouvelle commande.</div>
                    </div>
                    <group>
                        <field name="line_ids" invisible="1" force_save="1"/>
                        <field name="nb_lignes"/>
                        <field name="order_src_id" force_save="1" options="{'no_open': True}"/>
                        <field name="partner_id" options="{'no_open': True}"/>
                        <field name="product_src_id" force_save="1" options="{'no_open': True}"/>
                        <field name="segment_id" options="{'no_open': True}"/>
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="order_id" options="{'no_open': True}" attrs="{'invisible': [('product_id', '=', False)]}"/>
                    </group>
                    <div style="background:orange;padding:8px" attrs="{'invisible': ['|', ('product_id', '=', False), ('order_id', '!=', False)]}">
                        Aucune commande ouverte (devis) pour ce nouvel article et ce client : elle doit d'abord être créée par l'ADV.
                    </div>
                    <footer>
                        <button name="action_basculer" string="Basculer" type="object" class="btn-primary" data-hotkey="q"/>
                        <button string="Annuler" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="sale_order_line_basculer_wizard_action" model="ir.actions.act_window">
            <field name="name">Basculer sur un autre article</field>
            <field name="res_model">sale.order.line.basculer.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="sale.model_sale_order_line"/>
            <field name="binding_view_types">list</field>
        </record>
    </data>
</odoo>
