<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="is_galia_base_copier_uc_wizard_form_view" model="ir.ui.view">
            <field name="name">is.galia.base.copier.uc.wizard.form</field>
            <field name="model">is.galia.base.copier.uc.wizard</field>
            <field name="arch" type="xml">
                <form string="Copier dans les UC de la base du site">
                    <div style="background:Gainsboro;padding:8px;margin-bottom:12px">
                        Une nouvelle UM est créée dans l'emplacement Client de la base de destination pour chaque article et lot.
                        Si une étiquette est en erreur (UC déjà présente, article non trouvé...), rien n'est copié.
                    </div>
                    <div style="background:orange;padding:8px;margin-bottom:12px" attrs="{'invisible': [('inter_site', '=', False)]}">
                        Copie inter-site : l'article est recherché dans la base des étiquettes puis par son code PG dans la base de destination.
                        Les UC ne seront pas liées à l'OF.
                    </div>
                    <group>
                        <field name="galia_ids" invisible="1" force_save="1"/>
                        <field name="nb_etiquettes"/>
                        <field name="database_origine_id" force_save="1" options="{'no_open': True}"/>
                        <field name="database_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="inter_site" invisible="1"/>
                    </group>
                    <footer>
                        <button name="action_copier" string="Copier" type="object" class="btn-primary" data-hotkey="q"/>
                        <button string="Annuler" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="is_galia_base_copier_uc_wizard_action" model="ir.actions.act_window">
            <field name="name">Copier dans les UC de la base du site</field>
            <field name="res_model">is.galia.base.copier.uc.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_is_galia_base"/>
            <field name="binding_view_types">list,form</field>
            <field name="groups_id" eval="[(6,0,[ref('is_administration_vente_group')])]"/>
        </record>
    </data>
</odoo>
