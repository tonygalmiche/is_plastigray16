<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="is_fusionner_um_seq" model="ir.sequence">
            <field name="name">Fusionner des UM</field>
            <field name="code">is.fusionner.um</field>
            <field name="prefix">FUM-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>


        <!-- is.fusionner.um -->
        <!-- Action avant le formulaire, qui y fait référence (bouton « Retour à la liste ») -->
        <record model="ir.actions.act_window" id="is_fusionner_um_action">
            <field name="name">Historique fusions</field>
            <field name="res_model">is.fusionner.um</field>
            <field name="view_mode">tree,kanban,form</field>
        </record>
        <record model="ir.ui.view" id="is_fusionner_um_form_view">
            <field name="name">is_fusionner_um_form_view</field>
            <field name="model">is.fusionner.um</field>
            <field name="arch" type="xml">
                <form create="false" class="o_is_fusionner_um">
                    <sheet>
                        <field name="state" invisible="1"/>
                        <!-- Sans invisible="1" : en Odoo 16, un champ invisible n'est pas monté et le widget ne reçoit pas les scans -->
                        <field name="_barcode_scanned" widget="barcode_handler"/>
                        <div class="alert alert-info fs-5 py-1 px-2 mt-1 mb-1" role="status" attrs="{'invisible': [('action_attendue', '=', False)]}">
                            <i class="fa fa-barcode me-2" title="Action attendue"/><field name="action_attendue"/>
                        </div>
                        <div class="alert alert-danger py-1 px-2 mb-1" role="alert" attrs="{'invisible': [('alerte', '=', False)]}">
                            <field name="alerte"/>
                        </div>
                        <div class="alert alert-success py-1 px-2 mb-1" role="status" attrs="{'invisible': [('message', '=', False)]}">
                            <field name="message"/>
                        </div>
                        <div class="bg-light border rounded py-1 px-2 mb-1">
                            <field name="info_html" nolabel="1"/>
                        </div>
                        <div class="o_is_titre" attrs="{'invisible': [('ligne_ids', '=', [])]}">UM</div>
                        <!-- Une carte par UM, non cliquable (pas de oe_kanban_global_click) : poubelle pour retirer une UM (erreur de scan) -->
                        <field name="ligne_ids" nolabel="1" readonly="1" mode="kanban" attrs="{'invisible': [('ligne_ids', '=', [])]}">
                            <kanban create="false" class="o_is_fusionner_um_lignes">
                                <field name="state"/>
                                <field name="libelle"/>
                                <field name="um_id"/>
                                <field name="uc_id"/>
                                <field name="gardee"/>
                                <field name="articles"/>
                                <field name="nb_uc"/>
                                <field name="quantite"/>
                                <templates>
                                    <t t-name="kanban-box">
                                        <!-- Loupe à gauche et poubelle à droite, éloignées pour éviter un appui par erreur -->
                                        <div class="d-flex align-items-center px-2 py-1">
                                            <button
                                                name="voir_um_action"
                                                type="object"
                                                class="btn btn-link p-0 me-3"
                                                title="Voir l'UM"
                                            ><i class="fa fa-search-plus fa-lg" title="Voir l'UM"/></button>
                                            <div class="flex-grow-1 text-truncate">
                                                <b><t t-esc="record.libelle.value"/></b>
                                                <span t-if="record.gardee.raw_value" class="badge ms-1" style="background-color:#28a745;color:#fff">gardée</span>
                                                <span t-elif="record.state.raw_value == 'termine'" class="badge ms-1" style="background-color:#fd7e14;color:#fff">fusionnée</span>
                                                <span t-else="" class="badge ms-1" style="background-color:#fd7e14;color:#fff">à fusionner</span>
                                                <div class="text-muted small text-truncate">
                                                    <t t-if="record.uc_id.raw_value">UM <t t-esc="record.um_id.value"/> · </t><t t-esc="record.articles.value"/>
                                                </div>
                                            </div>
                                            <div class="text-nowrap ms-2"><t t-esc="record.nb_uc.value"/> UC · <b><t t-esc="record.quantite.value"/></b></div>
                                            <button
                                                t-if="record.state.raw_value == 'scan'"
                                                name="supprimer_action"
                                                type="object"
                                                class="btn btn-link text-danger p-0 ms-3"
                                                title="Retirer l'UM de la fiche"
                                            ><i class="fa fa-trash fa-lg" title="Retirer"/></button>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                        <button
                            name="nouvelle_fusion_action"
                            string="Nouvelle fusion"
                            type="object"
                            class="btn-primary w-100 mb-2 fs-5 d-md-none"
                            attrs="{'invisible': [('state', 'not in', ('termine', 'annule'))]}"
                        />
                        <div class="d-flex mb-3" attrs="{'invisible': [('state', '!=', 'scan')]}">
                            <field name="code" placeholder="Saisie manuelle d'un code UM, ou UC seule dans son UM" class="flex-grow-1 me-2"/>
                            <button name="valider_code_action" string="Valider" type="object" class="btn-secondary"/>
                        </div>
                        <group>
                            <field name="imprimante_id" options="{'no_create': True, 'no_open': True}" attrs="{'readonly': [('state', '!=', 'scan')]}"/>
                        </group>
                        <!-- Fusion après l'imprimante (choisie avant), séparée des autres boutons pour éviter un appui par erreur -->
                        <button
                            name="fusionner_action"
                            string="Fusionner les UM"
                            type="object"
                            class="btn-primary w-100 mt-5 mb-5 fs-5"
                            confirm="Fusionner les UM dans la première et réimprimer son étiquette ?"
                            attrs="{'invisible': [('state', '!=', 'scan')]}"
                        />
                        <button
                            name="annuler_action"
                            string="Annuler"
                            type="object"
                            class="btn-secondary o_is_btn_gris w-100 mb-2"
                            confirm="Retirer toutes les UM scannées ? Rien n'a été modifié."
                            attrs="{'invisible': ['|', ('state', '!=', 'scan'), ('ligne_ids', '=', [])]}"
                        />
                        <!-- Sur smartphone, la barre du haut est masquée (fusionner_um.js) : retour à la liste par ce bouton -->
                        <button
                            name="%(is_fusionner_um_action)d"
                            string="Retour à la liste"
                            type="action"
                            class="btn-secondary o_is_btn_gris w-100 mt-4 mb-2 d-md-none"
                        />
                        <!-- Abandon tout en bas, séparé des autres boutons pour éviter un appui par erreur -->
                        <button
                            name="abandonner_action"
                            string="Abandonner"
                            type="object"
                            class="btn-outline-danger w-100 mt-4 mb-2"
                            confirm="Abandonner ? Rien n'a été modifié."
                            attrs="{'invisible': [('state', '!=', 'scan')]}"
                        />
                        <!-- Détail pour le PC seulement : masqué sur smartphone (Zebra TC22) -->
                        <div class="d-none d-md-block">
                        <div class="d-flex gap-2 mt-2 mb-2">
                            <button name="voir_ums_action" string="UM" type="object" icon="fa-cubes" class="btn-secondary" attrs="{'invisible': [('ligne_ids', '=', [])]}"/>
                            <button name="voir_ucs_action" string="UC" type="object" icon="fa-cube" class="btn-secondary" attrs="{'invisible': [('ligne_ids', '=', [])]}"/>
                        </div>
                        <notebook>
                            <page string="Détail">
                                <group>
                                    <group>
                                        <field name="um_id"/>
                                        <field name="location_id"/>
                                        <field name="impression"/>
                                    </group>
                                    <group>
                                        <field name="create_date"/>
                                        <field name="create_uid"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                        </div>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>
        <!-- Confirmation de la poubelle : détail de la ligne pour être sûr de retirer la bonne UM -->
        <record model="ir.ui.view" id="is_fusionner_um_ligne_supprimer_form_view">
            <field name="name">is_fusionner_um_ligne_supprimer_form_view</field>
            <field name="model">is.fusionner.um.ligne</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <form create="false" edit="false">
                    <group>
                        <field name="libelle" readonly="1"/>
                        <field name="articles" readonly="1"/>
                        <field name="nb_uc" string="UC" readonly="1"/>
                        <field name="quantite" string="Pièces" readonly="1"/>
                        <field name="gardee" readonly="1"/>
                    </group>
                    <footer>
                        <button name="confirmer_suppression_action" string="Retirer cette UM" type="object" class="btn-danger"/>
                        <button string="Annuler" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="is_fusionner_um_tree_view">
            <field name="name">is_fusionner_um_tree_view</field>
            <field name="model">is.fusionner.um</field>
            <field name="arch" type="xml">
                <tree create="false">
                    <field name="name"/>
                    <field name="um_id"/>
                    <field name="location_id" optional="show"/>
                    <field name="create_date" optional="show"/>
                    <field name="create_uid" optional="show"/>
                    <field name="state" widget="badge" decoration-info="state == 'scan'" decoration-success="state == 'termine'" decoration-muted="state == 'annule'" optional="show"/>
                </tree>
            </field>
        </record>
        <record model="ir.ui.view" id="is_fusionner_um_kanban_view">
            <field name="name">is_fusionner_um_kanban_view</field>
            <field name="model">is.fusionner.um</field>
            <field name="arch" type="xml">
                <kanban create="false" class="o_kanban_mobile o_is_fusionner_um_kanban">
                    <field name="state"/>
                    <field name="um_id"/>
                    <field name="location_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong class="fs-4"><field name="name"/></strong>
                                    <field name="state" widget="label_selection" options="{'classes': {'scan': 'info', 'termine': 'success', 'annule': 'default'}}"/>
                                </div>
                                <t t-if="record.um_id.raw_value">
                                    <div class="fw-bold fs-5">UM <field name="um_id"/></div>
                                    <div class="text-muted">
                                        <i class="fa fa-map-marker me-1" title="Emplacement"/><field name="location_id"/>
                                    </div>
                                </t>
                                <div t-else="" class="text-muted fst-italic">
                                    <i class="fa fa-barcode me-1" title="Aucune UM scannée"/>Aucune UM scannée
                                </div>
                                <div class="text-muted small mt-2 pt-2 border-top">
                                    <i class="fa fa-clock-o me-1" title="Date"/><field name="create_date"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record model="ir.ui.view" id="is_fusionner_um_search_view">
            <field name="name">is_fusionner_um_search_view</field>
            <field name="model">is.fusionner.um</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="um_id"/>
                    <field name="ligne_ids" string="UM (toutes)" filter_domain="[('ligne_ids.um_id', 'ilike', self)]"/>
                    <field name="location_id"/>
                    <filter name="termine" string="Terminés" domain="[('state', '=', 'termine')]"/>
                    <filter name="annule"  string="Annulés"  domain="[('state', '=', 'annule')]"/>
                    <group expand="0" string="Regrouper par">
                        <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="is_fusionner_um_nouveau_action" model="ir.actions.server">
            <field name="name">Fusionner des UM</field>
            <field name="model_id" ref="model_is_fusionner_um"/>
            <field name="state">code</field>
            <field name="code">action = model.nouveau_action()</field>
        </record>


        <!-- Liste des UM : fiche de fusion des UM cochées -->
        <record model="ir.actions.server" id="is_galia_base_um_fusionner_action">
            <field name="name">Fusionner les UM</field>
            <field name="model_id" ref="model_is_galia_base_um"/>
            <field name="binding_model_id" ref="model_is_galia_base_um"/>
            <field name="binding_view_types">list</field>
            <field name="groups_id" eval="[(6,0,[ref('is_fusionner_um_group')])]"/>
            <field name="state">code</field>
            <field name="code">action = records.fusionner_um_action()</field>
        </record>
    </data>
</odoo>
