<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="is_reception_sous_traitance_seq" model="ir.sequence">
            <field name="name">Réception sous-traitance</field>
            <field name="code">is.reception.sous.traitance</field>
            <field name="prefix">RST-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>


        <!-- Écran 1 : fournisseurs de sous-traitance qui ont des commandes en cours -->
        <record model="ir.ui.view" id="is_reception_st_partner_kanban_view">
            <field name="name">is_reception_st_partner_kanban_view</field>
            <field name="model">res.partner</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <kanban create="false" class="o_kanban_mobile o_is_reception_st_kanban">
                    <field name="name"/>
                    <field name="is_code"/>
                    <field name="is_adr_code"/>
                    <field name="is_reception_st_nb"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="p-2">
                                <button name="reception_st_commandes_action" type="object" class="btn btn-primary w-100 text-start fs-5">
                                    <field name="name"/>
                                    <span class="ms-2 small">(<field name="is_code"/>/<field name="is_adr_code"/>)</span>
                                </button>
                                <div class="bg-light text-muted rounded px-2 py-1 mt-1">
                                    <field name="is_reception_st_nb"/> réception<t t-if="record.is_reception_st_nb.raw_value > 1">s</t> en cours
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <!-- Écran 2 : commandes en cours du fournisseur -->
        <record model="ir.ui.view" id="is_reception_st_picking_kanban_view">
            <field name="name">is_reception_st_picking_kanban_view</field>
            <field name="model">stock.picking</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <kanban create="false" class="o_kanban_mobile o_is_reception_st_kanban">
                    <field name="name"/>
                    <field name="purchase_id"/>
                    <field name="product_id"/>
                    <field name="is_reception_st_qt"/>
                    <field name="is_reception_st_nb_uc"/>
                    <field name="scheduled_date"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="p-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong class="fs-4">Commande <field name="purchase_id"/></strong>
                                    <span class="text-muted"><field name="name"/></span>
                                </div>
                                <div><field name="product_id"/></div>
                                <div class="text-muted">
                                    <i class="fa fa-cubes me-1" title="Quantité à recevoir"/><field name="is_reception_st_qt"/> pièces
                                    <i class="fa fa-barcode ms-3 me-1" title="UC à scanner (théorique : quantité / quantité par UC)"/><field name="is_reception_st_nb_uc"/> UC théoriques
                                    <i class="fa fa-calendar ms-3 me-1" title="Date prévue"/><field name="scheduled_date" widget="date"/>
                                </div>
                                <button name="reception_st_scanner_action" type="object" class="btn btn-primary w-100 mt-2 fs-5">Réceptionner</button>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <!-- is.reception.sous.traitance -->
        <!-- Action avant le formulaire, qui y fait référence (bouton « Historique ») -->
        <record model="ir.actions.act_window" id="is_reception_sous_traitance_action">
            <field name="name">Réception sous-traitance</field>
            <field name="res_model">is.reception.sous.traitance</field>
            <field name="view_mode">tree,kanban,form</field>
        </record>
        <record model="ir.ui.view" id="is_reception_sous_traitance_form_view">
            <field name="name">is_reception_sous_traitance_form_view</field>
            <field name="model">is.reception.sous.traitance</field>
            <field name="arch" type="xml">
                <form create="false" class="o_is_reception_sous_traitance">
                    <sheet>
                        <field name="state" invisible="1"/>
                        <field name="partner_id" invisible="1"/>
                        <!-- Sans invisible="1" : en Odoo 16, un champ invisible n'est pas monté et le widget ne reçoit pas les scans -->
                        <field name="_barcode_scanned" widget="barcode_handler"/>
                        <div class="alert alert-info fs-5 py-1 px-2 mt-1 mb-1" role="status" attrs="{'invisible': [('action_attendue', '=', False)]}">
                            <i class="fa fa-barcode me-2" title="Action attendue"/><field name="action_attendue"/>
                        </div>
                        <div class="alert alert-danger py-1 px-2 mb-1" role="alert" attrs="{'invisible': [('alerte', '=', False)]}">
                            <field name="alerte"/>
                        </div>
                        <div class="alert alert-success py-1 px-2 mb-1" role="status" attrs="{'invisible': [('message', '=', False)]}">
                            <field name="message"/>
                        </div>
                        <div class="bg-light border rounded py-1 px-2 mb-1">
                            <field name="info_html" nolabel="1"/>
                        </div>
                        <div class="mb-2">
                            <field name="progression_html" nolabel="1"/>
                        </div>
                        <group>
                            <field name="num_bl" attrs="{'readonly': [('state', '!=', 'scan')]}"/>
                            <field name="date_reception" attrs="{'readonly': [('state', '!=', 'scan')]}"/>
                        </group>
                        <div class="d-flex mb-2" attrs="{'invisible': [('state', '!=', 'scan')]}">
                            <field name="code" placeholder="Saisie manuelle d'un code" class="flex-grow-1 me-2"/>
                            <button name="valider_code_action" string="Valider" type="object" class="btn-secondary"/>
                        </div>
                        <button
                            name="fin_um_action"
                            string="Fin UM"
                            type="object"
                            class="btn-primary w-100 mb-2 fs-5"
                            attrs="{'invisible': ['|', ('state', '!=', 'scan'), ('um_id', '=', False)]}"
                        />
                        <button
                            name="fin_controle_action"
                            string="Fin de contrôle"
                            type="object"
                            class="btn-success w-100 mb-2 fs-5"
                            confirm="Valider la réception avec la quantité scannée ?"
                            attrs="{'invisible': ['|', ('state', '!=', 'scan'), ('ligne_ids', '=', [])]}"
                        />
                        <field name="um_id" invisible="1"/>
                        <!-- Quantité modifiable : à l'enregistrement, l'UC est mise à jour et son étiquette réimprimée -->
                        <field name="ligne_ids" nolabel="1" attrs="{'readonly': [('state', '!=', 'scan')]}">
                            <tree editable="bottom" create="false" delete="false">
                                <field name="num_eti"/>
                                <field name="um_id"/>
                                <field name="quantite" sum="Total"/>
                                <field name="impression" optional="hide"/>
                            </tree>
                        </field>
                        <group>
                            <field name="imprimante_id" options="{'no_create': True, 'no_open': True}" attrs="{'readonly': [('state', '!=', 'scan')]}"/>
                        </group>
                        <button
                            name="retour_commandes_action"
                            string="Retour aux commandes"
                            type="object"
                            class="btn-secondary o_is_btn_gris w-100 mt-4 mb-2"
                        />
                        <!-- Abandon tout en bas, séparé des autres boutons pour éviter un appui par erreur -->
                        <button
                            name="abandonner_action"
                            string="Abandonner"
                            type="object"
                            class="btn-outline-danger w-100 mt-4 mb-2"
                            confirm="Abandonner ? Les UC et UM créées par le scan seront supprimées, la réception n'est pas modifiée."
                            attrs="{'invisible': [('state', '!=', 'scan')]}"
                        />
                        <!-- Détail pour le PC seulement : masqué sur smartphone (Zebra TC22) -->
                        <div class="d-none d-md-block">
                        <notebook>
                            <page string="Détail">
                                <group>
                                    <group>
                                        <field name="picking_id"/>
                                        <field name="purchase_id"/>
                                        <field name="move_id"/>
                                        <field name="product_id"/>
                                    </group>
                                    <group>
                                        <field name="qt_attendue"/>
                                        <field name="qt_scannee"/>
                                        <field name="create_date"/>
                                        <field name="create_uid"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                        </div>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="is_reception_sous_traitance_tree_view">
            <field name="name">is_reception_sous_traitance_tree_view</field>
            <field name="model">is.reception.sous.traitance</field>
            <field name="arch" type="xml">
                <tree create="false">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="purchase_id"/>
                    <field name="picking_id"/>
                    <field name="product_id" optional="show"/>
                    <field name="num_bl" optional="show"/>
                    <field name="date_reception" optional="show"/>
                    <field name="create_uid" optional="show"/>
                    <field name="state" widget="badge" decoration-info="state == 'scan'" decoration-success="state == 'termine'" decoration-muted="state == 'annule'" optional="show"/>
                </tree>
            </field>
        </record>
        <record model="ir.ui.view" id="is_reception_sous_traitance_kanban_view">
            <field name="name">is_reception_sous_traitance_kanban_view</field>
            <field name="model">is.reception.sous.traitance</field>
            <field name="arch" type="xml">
                <kanban create="false" class="o_kanban_mobile o_is_reception_st_kanban">
                    <field name="state"/>
                    <field name="partner_id"/>
                    <field name="purchase_id"/>
                    <field name="product_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong class="fs-4"><field name="name"/></strong>
                                    <field name="state" widget="label_selection" options="{'classes': {'scan': 'info', 'termine': 'success', 'annule': 'default'}}"/>
                                </div>
                                <div class="fw-bold">Commande <field name="purchase_id"/> · <field name="partner_id"/></div>
                                <div class="text-muted"><field name="product_id"/></div>
                                <div class="text-muted small mt-2 pt-2 border-top">
                                    <i class="fa fa-clock-o me-1" title="Date"/><field name="create_date"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record model="ir.ui.view" id="is_reception_sous_traitance_search_view">
            <field name="name">is_reception_sous_traitance_search_view</field>
            <field name="model">is.reception.sous.traitance</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="purchase_id"/>
                    <field name="picking_id"/>
                    <field name="product_id"/>
                    <field name="num_bl"/>
                    <field name="ligne_ids" string="N° UC" filter_domain="[('ligne_ids.num_eti', '=', self)]"/>
                    <filter name="scan"    string="En cours" domain="[('state', '=', 'scan')]"/>
                    <filter name="termine" string="Terminés" domain="[('state', '=', 'termine')]"/>
                    <filter name="annule"  string="Annulés"  domain="[('state', '=', 'annule')]"/>
                    <group expand="0" string="Regrouper par">
                        <filter name="group_state"      string="État"        context="{'group_by': 'state'}"/>
                        <filter name="group_partner_id" string="Fournisseur" context="{'group_by': 'partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="is_reception_sous_traitance_fournisseurs_action" model="ir.actions.server">
            <field name="name">Réception sous-traitance</field>
            <field name="model_id" ref="model_is_reception_sous_traitance"/>
            <field name="state">code</field>
            <field name="code">action = model.fournisseurs_action()</field>
        </record>
    </data>
</odoo>
